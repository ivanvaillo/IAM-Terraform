{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSalesDataAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::insurance-sales-data/*"
    },
    {
      "Sid": "AllowSalesBucketListing",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::insurance-sales-data"
    }
  ]
}